# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Primary LLM Provider: Google AI Studio / Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Secondary LLM Provider: OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=Office Pigeon

# Tertiary LLM Provider: Cerebras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-4-scout-17b-16e-instruct

# Quaternary LLM Provider: Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Quinary LLM Provider: Cohere
COHERE_API_KEY=
COHERE_MODEL=command-r-plus

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=office-pigeon
PINECONE_INDEX_HOST=
PINECONE_USE_INTEGRATED_EMBEDDING=true

# Optional embedding fallback if Pinecone integrated embedding is not used
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# Office Pigeon
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CALCOM_URL=https://cal.com/office-pigeon/demo-call
NEXT_PUBLIC_WHATSAPP_NUMBER=19176726764
OFFICE_PIGEON_EMAIL_TO=contactus@officepigeon.com
OFFICE_PIGEON_EMAIL_FROM=

# Email Provider: resend, sendgrid, or smtp
EMAIL_PROVIDER=
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Admin
ADMIN_REINDEX_SECRET=

# Chatbot Settings
PIP_AI_CONFIDENCE_THRESHOLD=0.55
PIP_AI_MAX_CONTEXT_CHUNKS=6
PIP_AI_MAX_HISTORY_MESSAGES=12
PIP_AI_PROVIDER_TIMEOUT_MS=20000

# Existing Vite/Express compatibility
PORT=3000
APP_URL=
