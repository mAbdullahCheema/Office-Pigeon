# Copy to .env.local and fill in. Nothing here is secret; the real values are.

# ── Supabase ─────────────────────────────────────────────────────────────
# Project Settings → API. The URL and publishable key are sent to the browser
# by design — row level security in Postgres is what guards the data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only. Bypasses row level security — never expose it to the
# browser, and never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy JWT keys. The same two roles as the pair above, in the older format
# that some tooling and SQL snippets still expect. The service-role JWT is what
# database triggers use to sign their calls to edge functions.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, for psql and migration tooling. Optional: the app
# never uses it. Percent-encode any `@` in the password as %40. The `db.` host
# resolves to IPv6 only; on a network without an IPv6 route use the transaction
# pooler string from Project Settings → Database instead.
SUPABASE_DB_URL=

# ── Site ─────────────────────────────────────────────────────────────────
# Must match the deployed origin exactly: OAuth and password-recovery links are
# built from it, and Supabase only redirects to URLs on its allow-list.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── First owner ──────────────────────────────────────────────────────────
# Read only by `npm run db:create-admin`, which creates the account and gives
# it the owner role. Remove the password once the account exists.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Office Pigeon Admin

# ── Email ────────────────────────────────────────────────────────────────
# There is none, deliberately. The app's own alerts — a new lead, a payment
# submitted, the daily digest — are rows in `public.notifications`, shown live
# in the dashboard, so no provider, API key or sending domain is involved.
# Registration creates a confirmed account and signs straight in, and a
# locked-out customer is recovered by an owner or admin from
# Dashboard → People → Customers → Set a new password.

# ── Google sign-in ───────────────────────────────────────────────────────
# Set to `false` to hide the button. Enabling it properly is two steps:
#
#   1. Google Cloud → Credentials → OAuth client → Authorised redirect URIs:
#        https://<project-ref>.supabase.co/auth/v1/callback
#   2. Supabase → Authentication → Sign In / Providers → Google: paste the
#      client id and secret, and enable it.
#
# Then add these to Authentication → URL Configuration → Redirect URLs:
#   http://localhost:3000/api/auth/callback
#   https://yourdomain.com/api/auth/callback
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# ── Pip, the AI assistant ────────────────────────────────────────────────
# Set to `false` to take Pip off the site. With it off the widget still loads
# and still points at the human channels, so nothing on the page breaks.
PIP_ENABLED=true

# Language models, tried strictly in this order. Each tier is skipped when its
# key is missing, and a tier that errors — quota, outage, a refused project —
# simply hands on to the next, so a partial set still works.
#
# Every tier must support tool calling: Pip is useless without its tools, and a
# model that silently ignores them would answer from thin air.
#
#   1. OpenRouter, DeepSeek v4 Flash — fast, cheap, long context
#   2. Google AI Studio, Gemini      — a different company, not just a different route
#   3. OpenRouter, free model        — covers OpenRouter credit running out
#   4. Cerebras, gpt-oss-120b        — very fast, free tier
#   5. Groq, gpt-oss-120b            — last resort, different network path again
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_FREE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
GOOGLE_AI_API_KEY=
# Measured, not assumed: gemini-3.7-flash and gemini-flash-latest were both
# returning 503s and taking 40-70 seconds, while 3.6 answers in about two.
GOOGLE_MODEL=gemini-3.6-flash
CEREBRAS_API_KEY=csk-...
CEREBRAS_MODEL=gpt-oss-120b
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# ── Pinecone ─────────────────────────────────────────────────────────────
# The knowledge Pip answers from. The index carries its own embedding model
# (llama-text-embed-v2), so text goes in and comes out as text — there is no
# separate embedding provider to key or to keep in step.
# `npm run kb:index` rebuilds the namespace from the live site content.
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_HOST=https://<index>-<id>.svc.<region>.pinecone.io
PINECONE_NAMESPACE=office-pigeon-production

# ── Cal.com ──────────────────────────────────────────────────────────────
# The consultation Pip can offer and book. The event type id is the numeric id
# from Event Types → the event → its URL, not the slug.
CALCOM_API_KEY=cal_live_...
CALCOM_EVENT_TYPE_ID=5311584
CALCOM_USERNAME=office-pigeon
CALCOM_EVENT_SLUG=demo-call

# ── Redis (optional) ─────────────────────────────────────────────────────
# Shares rate-limit counters and the content cache across instances. Without
# it both fall back to per-process state, which still works on one instance.
# Use rediss:// (not redis://) so TLS is negotiated.
REDIS_URL=

# ── Keep-alive cron ──────────────────────────────────────────────────────
# The bearer token `.github/workflows/keepalive.yml` sends to
# POST /api/cron/keepalive, which does one read against Postgres so a free-tier
# Supabase project is never paused for inactivity. Generate a fresh one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# The same value goes in the host's environment and in the repository's
# Actions secrets. With it unset the endpoint answers 401 to everyone.
CRON_SECRET=

# ── Sentry (optional) ────────────────────────────────────────────────────
# Error and performance monitoring. The DSN is public by design — it only
# identifies where to send events. With it unset, `next.config.ts` does not
# even load Sentry's build plugin.
NEXT_PUBLIC_SENTRY_DSN=
# Server-side DSN. Leave blank to reuse the public one above.
SENTRY_DSN=
# Names the deployment in Sentry's environment filter. Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=production

# Only needed to upload source maps at build time, which is what turns a
# minified stack trace back into your own code. Create it at
# Sentry → Settings → Auth Tokens with the `project:releases` scope. Without
# it the build still succeeds; the traces are just minified.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
