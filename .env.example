# App
APP_URL="https://yourdomain.com"

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# M1: Google AI Studio / Gemini
GEMINI_API_KEY="your-gemini-key"
# Optional alias also supported by server.ts:
GOOGLE_AI_API_KEY="your-gemini-key"

# M2: OpenRouter
OPENROUTER_API_KEY="your-openrouter-key"
OPENROUTER_MODEL="google/gemini-2.5-flash"

# M3: Cerebras
CEREBRAS_API_KEY="your-cerebras-key"
CEREBRAS_MODEL="llama-4-scout-17b-16e-instruct"

# M4: Groq
GROQ_API_KEY="your-groq-key"
GROQ_MODEL="llama-3.1-8b-instant"

# M5: Cohere
COHERE_API_KEY="your-cohere-key"
COHERE_MODEL="command-r-plus"

# Pinecone
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=office-pigeon
PINECONE_NAMESPACE=office-pigeon-production
PINECONE_INDEX_HOST=https://your-index.svc.aped-4627-b74a.pinecone.io
PINECONE_USE_INTEGRATED_EMBEDDING=true

# Optional embedding fallback if Pinecone integrated embedding is not used
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# Office Pigeon
NEXT_PUBLIC_SITE_URL=yourdomain.com
NEXT_PUBLIC_CALCOM_URL=https://cal.com/your-username/demo-call
NEXT_PUBLIC_WHATSAPP_NUMBER=1XXXXXXXXXX
OFFICE_PIGEON_EMAIL_TO=your@email.com
OFFICE_PIGEON_EMAIL_FROM=your@email.com

# Email Provider: resend, sendgrid, or smtp
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=your@email.com
SMTP_PASS=your-password

# Admin
ADMIN_REINDEX_SECRET=your-secret
ADMIN_EMAILS=m.abdullahcheema9@gmail.com
OFFICE_PIGEON_WHATSAPP_NUMBER=19176726764
OFFICE_PIGEON_PUBLIC_URL=https://officepigeon.com

# Chatbot Settings
PIP_AI_CONFIDENCE_THRESHOLD=0.55
PIP_AI_MAX_CONTEXT_CHUNKS=6
PIP_AI_MAX_HISTORY_MESSAGES=12
PIP_AI_PROVIDER_TIMEOUT_MS=20000

# Gemini model override (optional)
GEMINI_MODEL=gemini-2.5-flash
