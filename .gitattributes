# Normalize line endings to LF in the repo (stops the LF/CRLF churn on Windows checkouts)
* text=auto eol=lf

# Binary assets — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary

# Keep these as LF text
*.svg text eol=lf
*.jsonl text eol=lf
